  m_Script: {fileID: 11500000, guid: fcad2fab55b16db4e9a04f43af0c034e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueUI: {fileID: 0}
  promptUI: {fileID: 0}
  speakerNameText: {fileID: 0}
  dialogueLineText: {fileID: 0}
  speakerNames:
  - flora
  - Melodia
  - flora
  - Melodia
  - Melodia
  - flora
  - flora
  - Melodia
  - Melodia
  - flora
  dialogueLines:
  - "Me diz que j\xE1 acabou... Por favor!"
  - "O inverno j\xE1 acabou... Fez muito frio? Estava agasalhada o suficiente?"
  - 'Quase fui engolida pela avalanche! '
  - Sinto muito querida...
  - "Clave me disse que voc\xEA viria... Perdi o controle do inverno a muito tempo,
    fiquei com medo que isso te prejudicasse mais..."
  - "Bem... Agrade\xE7o a preocupa\xE7\xE3o, mas isso foi SINISTRO! Nunca corri tanto
    em minha vida! Voc\xEA tem no\xE7\xE3o?! "
  - "Mas ai est\xE1! A m\xFAsica est\xE1 de volta! Onde mais preciso ir? Tem mais
    reinos?"
  - "Oh querida... Escuto a m\xFAsica... Agrade\xE7o por nos permitir ouvir a maravilhosa
    melodia viva e vibrante."
  - "Voc\xEA acabou, pode ir... Sua miss\xE3o aqui est\xE1 completa... Te levarei
    at\xE9 o encontro dos outros, vamos te enviar novamente para casa."
  - "Obrigada, obrigada e obrigada! Por onde \xE9 o caminho? Quando vamos chegar?
    Vamos logo por favor!"
  delayBeforeNextScene: 0
  nextSceneName: Menu
