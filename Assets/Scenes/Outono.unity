      value: ???
      objectReference: {fileID: 0}
    - target: {fileID: 3862446723559953398, guid: 864258ecc0928bc4caf62d1ad93c3f38, type: 3}
      propertyPath: 'speakerNames.Array.data[5]'
      value: Flora
      objectReference: {fileID: 0}
    - target: {fileID: 3862446723559953398, guid: 864258ecc0928bc4caf62d1ad93c3f38, type: 3}
      propertyPath: 'speakerNames.Array.data[6]'
      value: ???
      objectReference: {fileID: 0}
    - target: {fileID: 3862446723559953398, guid: 864258ecc0928bc4caf62d1ad93c3f38, type: 3}
      propertyPath: 'speakerNames.Array.data[7]'
      value: Flora
      objectReference: {fileID: 0}
    - target: {fileID: 3862446723559953398, guid: 864258ecc0928bc4caf62d1ad93c3f38, type: 3}
      propertyPath: 'speakerNames.Array.data[8]'
      value: Ritmo
      objectReference: {fileID: 0}
    - target: {fileID: 3862446723559953398, guid: 864258ecc0928bc4caf62d1ad93c3f38, type: 3}
      propertyPath: 'speakerNames.Array.data[9]'
      value: Ritmo
      objectReference: {fileID: 0}
    - target: {fileID: 3862446723559953398, guid: 864258ecc0928bc4caf62d1ad93c3f38, type: 3}
      propertyPath: 'dialogueLines.Array.data[0]'
      value: "O que? Quem?! Quem \xE9 voc\xEA?!  "
      objectReference: {fileID: 0}
    - target: {fileID: 3862446723559953398, guid: 864258ecc0928bc4caf62d1ad93c3f38, type: 3}
      propertyPath: 'dialogueLines.Array.data[1]'
      value: "T\xE1 tudo bem? Voc\xEAs me trouxeram aqui para ajudar os reinos n\xE3o
        foi? "
      objectReference: {fileID: 0}
    - target: {fileID: 3862446723559953398, guid: 864258ecc0928bc4caf62d1ad93c3f38, type: 3}
      propertyPath: 'dialogueLines.Array.data[2]'
      value: "Ningu\xE9m te enviou aqui!"
      objectReference: {fileID: 0}
    - target: {fileID: 3862446723559953398, guid: 864258ecc0928bc4caf62d1ad93c3f38, type: 3}
      propertyPath: 'dialogueLines.Array.data[3]'
      value: "Espera... Que som \xE9 esse? "
      objectReference: {fileID: 0}
    - target: {fileID: 3862446723559953398, guid: 864258ecc0928bc4caf62d1ad93c3f38, type: 3}
      propertyPath: 'dialogueLines.Array.data[4]'
      value: "Isso \xE9 m\xFAsica?! Voc\xEA trouxe a m\xFAsica?"
      objectReference: {fileID: 0}
    - target: {fileID: 3862446723559953398, guid: 864258ecc0928bc4caf62d1ad93c3f38, type: 3}
      propertyPath: 'dialogueLines.Array.data[5]'
      value: "Sim! Clave me trouxe at\xE9 aqui, para recuperar a m\xFAsica. Eu estou
        aqui para ajudar voc\xEAs!"
      objectReference: {fileID: 0}
    - target: {fileID: 3862446723559953398, guid: 864258ecc0928bc4caf62d1ad93c3f38, type: 3}
      propertyPath: 'dialogueLines.Array.data[6]'
      value: "Oh... Me desculpe! Achei que voc\xEA fosse tirar de n\xF3s mais do
        que nos restou. Fico grato pela gentileza, lhe darei o que quiser como premia\xE7\xE3o,
        basta pedir!"
      objectReference: {fileID: 0}
    - target: {fileID: 3862446723559953398, guid: 864258ecc0928bc4caf62d1ad93c3f38, type: 3}
      propertyPath: 'dialogueLines.Array.data[7]'
      value: 'Gostaria de saber o seu nome primeiro! '
      objectReference: {fileID: 0}
    - target: {fileID: 3862446723559953398, guid: 864258ecc0928bc4caf62d1ad93c3f38, type: 3}
      propertyPath: 'dialogueLines.Array.data[8]'
      value: 'Eu sou o Ritmo, rei e defensor do Outono, onde as folhas caem ritmadas
        com o som do vento. '
      objectReference: {fileID: 0}
    - target: {fileID: 3862446723559953398, guid: 864258ecc0928bc4caf62d1ad93c3f38, type: 3}
      propertyPath: 'dialogueLines.Array.data[9]'
      value: "Ah o vento... Achei que nunca mais veria as folhas dan\xE7ando com
        o vento."
      objectReference: {fileID: 0}
    - target: {fileID: 3862446723559953398, guid: 864258ecc0928bc4caf62d1ad93c3f38, type: 3}
      propertyPath: 'speakerNames.Array.data[10]'
      value: Ritmo
      objectReference: {fileID: 0}
    - target: {fileID: 3862446723559953398, guid: 864258ecc0928bc4caf62d1ad93c3f38, type: 3}
      propertyPath: 'speakerNames.Array.data[11]'
      value: Flora
      objectReference: {fileID: 0}
    - target: {fileID: 3862446723559953398, guid: 864258ecc0928bc4caf62d1ad93c3f38, type: 3}
      propertyPath: 'speakerNames.Array.data[12]'
      value: Ritmo
      objectReference: {fileID: 0}
    - target: {fileID: 3862446723559953398, guid: 864258ecc0928bc4caf62d1ad93c3f38, type: 3}
      propertyPath: 'speakerNames.Array.data[13]'
      value: Ritmo
      objectReference: {fileID: 0}
    - target: {fileID: 3862446723559953398, guid: 864258ecc0928bc4caf62d1ad93c3f38, type: 3}
      propertyPath: 'speakerNames.Array.data[14]'
      value: Flora
      objectReference: {fileID: 0}
    - target: {fileID: 3862446723559953398, guid: 864258ecc0928bc4caf62d1ad93c3f38, type: 3}
      propertyPath: 'speakerNames.Array.data[15]'
      value: Ritmo
      objectReference: {fileID: 0}
    - target: {fileID: 3862446723559953398, guid: 864258ecc0928bc4caf62d1ad93c3f38, type: 3}
      propertyPath: 'dialogueLines.Array.data[10]'
      value: "Certo mo\xE7oila! Siga seu rumo at\xE9 o pr\xF3ximo reino e termine
        sua miss\xE3o aqui!"
      objectReference: {fileID: 0}
    - target: {fileID: 3862446723559953398, guid: 864258ecc0928bc4caf62d1ad93c3f38, type: 3}
      propertyPath: 'dialogueLines.Array.data[11]'
      value: "Tudo bem! Mas e meu pr\xEAmio? "
      objectReference: {fileID: 0}
    - target: {fileID: 3862446723559953398, guid: 864258ecc0928bc4caf62d1ad93c3f38, type: 3}
      propertyPath: 'dialogueLines.Array.data[12]'
      value: "Voc\xEA j\xE1 pediu! Agora v\xE1 antes que tentem roubar a minha m\xFAsica!"
      objectReference: {fileID: 0}
    - target: {fileID: 3862446723559953398, guid: 864258ecc0928bc4caf62d1ad93c3f38, type: 3}
      propertyPath: 'dialogueLines.Array.data[13]'
      value: "S\xF3 cuidado, neste pr\xF3ximo desafio a natureza \xE9 bem mais perigosa
        e v\xE3o ter mais \"coisas\" tentando te impedir."
      objectReference: {fileID: 0}
    - target: {fileID: 3862446723559953398, guid: 864258ecc0928bc4caf62d1ad93c3f38, type: 3}
      propertyPath: 'dialogueLines.Array.data[14]'
      value: Pode deixar, tomarei mais cuidado, Obrigado.
      objectReference: {fileID: 0}
    - target: {fileID: 3862446723559953398, guid: 864258ecc0928bc4caf62d1ad93c3f38, type: 3}
      propertyPath: 'dialogueLines.Array.data[15]'
      value: "Ah!! e tem mais uma coisa, cuidado com a Avalanche ela n\xE3o perdoa
        a sua demora."
      objectReference: {fileID: 0}
    - target: {fileID: 5380430787189115025, guid: 864258ecc0928bc4caf62d1ad93c3f38, type: 3}
      propertyPath: m_LocalPosition.x
      value: 456.47
      objectReference: {fileID: 0}
