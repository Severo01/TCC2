      value: Melodia
      objectReference: {fileID: 0}
    - target: {fileID: 482566072476848603, guid: 520760b653256bd4e86c494ae7e9b32e, type: 3}
      propertyPath: 'speakerNames.Array.data[2]'
      value: flora
      objectReference: {fileID: 0}
    - target: {fileID: 482566072476848603, guid: 520760b653256bd4e86c494ae7e9b32e, type: 3}
      propertyPath: 'speakerNames.Array.data[3]'
      value: Melodia
      objectReference: {fileID: 0}
    - target: {fileID: 482566072476848603, guid: 520760b653256bd4e86c494ae7e9b32e, type: 3}
      propertyPath: 'speakerNames.Array.data[4]'
      value: Melodia
      objectReference: {fileID: 0}
    - target: {fileID: 482566072476848603, guid: 520760b653256bd4e86c494ae7e9b32e, type: 3}
      propertyPath: 'speakerNames.Array.data[5]'
      value: flora
      objectReference: {fileID: 0}
    - target: {fileID: 482566072476848603, guid: 520760b653256bd4e86c494ae7e9b32e, type: 3}
      propertyPath: 'speakerNames.Array.data[6]'
      value: flora
      objectReference: {fileID: 0}
    - target: {fileID: 482566072476848603, guid: 520760b653256bd4e86c494ae7e9b32e, type: 3}
      propertyPath: 'speakerNames.Array.data[7]'
      value: Melodia
      objectReference: {fileID: 0}
    - target: {fileID: 482566072476848603, guid: 520760b653256bd4e86c494ae7e9b32e, type: 3}
      propertyPath: 'speakerNames.Array.data[8]'
      value: Melodia
      objectReference: {fileID: 0}
    - target: {fileID: 482566072476848603, guid: 520760b653256bd4e86c494ae7e9b32e, type: 3}
      propertyPath: 'speakerNames.Array.data[9]'
      value: flora
      objectReference: {fileID: 0}
    - target: {fileID: 482566072476848603, guid: 520760b653256bd4e86c494ae7e9b32e, type: 3}
      propertyPath: 'dialogueLines.Array.data[0]'
      value: "Me diz que j\xE1 acabou... Por favor!"
      objectReference: {fileID: 0}
    - target: {fileID: 482566072476848603, guid: 520760b653256bd4e86c494ae7e9b32e, type: 3}
      propertyPath: 'dialogueLines.Array.data[1]'
      value: "O inverno j\xE1 acabou... Fez muito frio? Estava agasalhada o suficiente?"
      objectReference: {fileID: 0}
    - target: {fileID: 482566072476848603, guid: 520760b653256bd4e86c494ae7e9b32e, type: 3}
      propertyPath: 'dialogueLines.Array.data[2]'
      value: 'Quase fui engolida pela avalanche! '
      objectReference: {fileID: 0}
    - target: {fileID: 482566072476848603, guid: 520760b653256bd4e86c494ae7e9b32e, type: 3}
      propertyPath: 'dialogueLines.Array.data[3]'
      value: Sinto muito querida...
      objectReference: {fileID: 0}
    - target: {fileID: 482566072476848603, guid: 520760b653256bd4e86c494ae7e9b32e, type: 3}
      propertyPath: 'dialogueLines.Array.data[4]'
      value: "Clave me disse que voc\xEA viria... Perdi o controle do inverno a muito
        tempo, fiquei com medo que isso te prejudicasse mais..."
      objectReference: {fileID: 0}
    - target: {fileID: 482566072476848603, guid: 520760b653256bd4e86c494ae7e9b32e, type: 3}
      propertyPath: 'dialogueLines.Array.data[5]'
      value: "Bem... Agrade\xE7o a preocupa\xE7\xE3o, mas isso foi SINISTRO! Nunca
        corri tanto em minha vida! Voc\xEA tem no\xE7\xE3o?! "
      objectReference: {fileID: 0}
    - target: {fileID: 482566072476848603, guid: 520760b653256bd4e86c494ae7e9b32e, type: 3}
      propertyPath: 'dialogueLines.Array.data[6]'
      value: "Mas ai est\xE1! A m\xFAsica est\xE1 de volta! Onde mais preciso ir?
        Tem mais reinos?"
      objectReference: {fileID: 0}
    - target: {fileID: 482566072476848603, guid: 520760b653256bd4e86c494ae7e9b32e, type: 3}
      propertyPath: 'dialogueLines.Array.data[7]'
      value: "Oh querida... Escuto a m\xFAsica... Agrade\xE7o por nos permitir ouvir
        a maravilhosa melodia viva e vibrante."
      objectReference: {fileID: 0}
    - target: {fileID: 482566072476848603, guid: 520760b653256bd4e86c494ae7e9b32e, type: 3}
      propertyPath: 'dialogueLines.Array.data[8]'
      value: "Voc\xEA acabou, pode ir... Sua miss\xE3o aqui est\xE1 completa... Te
        levarei at\xE9 o encontro dos outros, vamos te enviar novamente para casa."
      objectReference: {fileID: 0}
    - target: {fileID: 482566072476848603, guid: 520760b653256bd4e86c494ae7e9b32e, type: 3}
      propertyPath: 'dialogueLines.Array.data[9]'
      value: "Obrigada, obrigada e obrigada! Por onde \xE9 o caminho? Quando vamos
        chegar? Vamos logo por favor!"
      objectReference: {fileID: 0}
